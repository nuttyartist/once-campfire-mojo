    out += "\" accept-charset=\"UTF-8\" method=\"post\">\n"
    out += "        <fieldset data-composer-target=\"fields\" contents>\n"
    out += "          <div class=\"flex flex-column\">\n"
    out += "            <div class=\"composer__filelist flex flex--align-center gap flex-wrap\" data-composer-target=\"fileList\"></div>\n"
    out += "\n"
    out += "            <div class=\"flex composer__input input input--actor fill-white min-width\" style=\"--input-border-radius: 1.3rem\">\n"
    out += "              <div class=\"flex align-end gap full-width\">\n"
    out += "                <img aria-hidden=\"true\" class=\"composer__input-hint colorize--black\" style=\"view-transition-name: input-btn;\" src=\""
    out += asset("messages-outlined.svg")
    out += "\" width=\"22\" height=\"22\" />\n"
    out += "\n"
    out += "                <div class=\"flex flex-column flex-item-grow min-width gap\">\n"
    out += "                  <lexxy-editor rows=\"1\" class=\"input lexxy-content\" style=\"order: -1\" aria-multiline=\"true\" aria-label=\"Write a message\" permitted-attachment-types=\"application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed\" data-controller=\"unfurl\" data-action=\"lexxy:change-&gt;typing-notifications#start keydown-&gt;composer#submitByKeyboard:capture lexxy:change-&gt;composer#saveDraft lexxy:insert-link-&gt;unfurl#unfurl\" data-composer-target=\"text\" data-direct-upload-url=\""
    out += escape(v.get("base_url", ""))
    out += "/rails/active_storage/direct_uploads\" data-blob-url-template=\""
    out += escape(v.get("base_url", ""))
    out += "/rails/active_storage/blobs/redirect/:signed_id/:filename\" id=\"message_body\" input=\"message_body_trix_input_message\" name=\"message[body]\">\n"
    out += "                    <lexxy-prompt trigger=\"@\" name=\"mention\" src=\""
    out += escape(v.get("mention_path", ""))
    out += "\" remote-filtering=\"true\" empty-results=\"No matches\"></lexxy-prompt>\n"
    out += "</lexxy-editor>                </div>\n"
    out += "\n"
    out += "                <label class=\"btn btn--borderless txt-small flex-item-no-shrink composer__attachment-btn input--file\">\n"
    out += "                  <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("attachment.svg")
    out += "\" width=\"22\" height=\"22\" />\n"
    out += "                  <input type=\"file\" data-action=\"composer#filePicked\" multiple />\n"
    out += "                  <span class=\"for-screen-reader\">Attach a file</span>\n"
    out += "                </label>\n"
    out += "\n"
    out += "                <button class=\"btn btn--borderless txt-small flex-item-no-shrink composer__rich-text-btn\" type=\"button\" data-action=\"composer#toggleToolbar\">\n"
    out += "                  <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("text-options.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "                  <span class=\"for-screen-reader\">Rich text</span>\n"
    out += "                </button>\n"
    out += "\n"
    out += "                <button name=\"send\" type=\"submit\" data-action=\"composer#submit\" class=\"btn btn--reversed flex-item-no-shrink txt-small\">\n"
    out += "                  <img aria-hidden=\"true\" src=\""
    out += asset("arrow-up.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "                  <span class=\"for-screen-reader\">Send Message</span>\n"
    out += "</button>              </div>\n"
    out += "            </div>\n"
    out += "          </div>\n"
    out += "        </fieldset>\n"
    out += "\n"
    out += "        <div class=\"typing-indicator gap txt-small align-center flex-inline\" data-typing-notifications-target=\"indicator\">\n"
    out += "          <div class=\"typing-indicator__author spinner\" data-typing-notifications-target=\"author\"></div>\n"
    out += "        </div>\n"
    out += "\n"
    out += "        <input data-composer-target=\"clientid\" type=\"hidden\" name=\"message[client_message_id]\" id=\"message_client_message_id\" />\n"
    out += "</form>    </turbo-frame>\n"
    out += "  </div>\n"
    return out^

def room_content(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<div id=\"message-area\" class=\"message-area\" contents=\"true\" data-controller=\"messages presence drop-target\" data-action=\"turbo:before-stream-render@document-&gt;messages#beforeStreamRender keydown.up@document-&gt;messages#editMyLastMessage dragenter-&gt;drop-target#dragenter dragover-&gt;drop-target#dragover drop-&gt;drop-target#drop visibilitychange@document-&gt;presence#visibilityChanged\" data-messages-first-of-day-class=\"message--first-of-day\" data-messages-formatted-class=\"message--formatted\" data-messages-me-class=\"message--me\" data-messages-mentioned-class=\"message--mentioned\" data-messages-threaded-class=\"message--threaded\" data-messages-page-url-value=\""
