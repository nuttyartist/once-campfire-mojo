def actions(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<div class=\"message__actions\" data-controller=\"soft-keyboard\">\n"
    out += "  <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\">\n"
    out += "    <summary class=\"btn message__action-btn message__options-btn\">\n"
    out += "      <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("menu-dots-horizontal.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "      <span class=\"for-screen-reader\">Message options</span>\n"
    out += "    </summary>\n"
    out += "\n"
    out += "    <div class=\"message__actions-menu border shadow\" data-popup-target=\"menu\">\n"
    out += "      <div class=\"quick-boosts\">\n"
    out += "        "
    out += v.get("reactions", "")
    out += "\n"
    out += "\n"
    out += "        <a class=\"btn message__action-btn message__boost-btn\" data-turbo-frame=\""
    out += escape(v.get("new_boost_dom", ""))
    out += "\" data-action=\"soft-keyboard#open popup#close\" href=\""
    out += escape(v.get("new_boost_path", ""))
    out += "\">\n"
    out += "          <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("boost.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "          <span class=\"for-screen-reader\">New boost</span>\n"
    out += "</a>      </div>\n"
    out += "\n"
    out += "      <div class=\"flex flex-wrap border-top margin-block-start-half pad-block-start-half message__actions-grid\">"
    if (v.get("has_attachment", "") == "1"):
        out += "\n"
        out += "          <a class=\"btn message__action-btn center full-width hide-in-ios-pwa\" title=\"Download\" aria-label=\"Download\" href=\""
        out += escape(v.get("download_path", ""))
        out += "\">\n"
        out += "            <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
        out += asset("download.svg")
        out += "\" width=\"20\" height=\"20\" />\n"
        out += "</a>\n"
        out += "          <button class=\"btn message__action-btn center full-width\" data-controller=\"web-share\" data-action=\"web-share#share\" data-web-share-files-value=\""
        out += escape(v.get("blob_path", ""))
        out += "\" data-web-share-title-value=\""
        out += escape(v.get("filename", ""))
        out += "\" title=\"Share\" aria-label=\"Share\">\n"
        out += "            <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
        out += asset("share.svg")
        out += "\" width=\"20\" height=\"20\" />\n"
        out += "</button>"
    else:
        out += "\n"
        out += "          <button class=\"btn message__action-btn center full-width\" data-action=\"reply#reply\" title=\"Reply\" aria-label=\"Reply\">\n"
        out += "            <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
        out += asset("reply.svg")
        out += "\" width=\"20\" height=\"20\" />\n"
        out += "</button>"
    out += "\n"
    out += "\n"
    out += "        <button class=\"btn message__action-btn center full-width\" title=\"Copy link\" aria-label=\"Copy link\" data-controller=\"copy-to-clipboard\" data-action=\"copy-to-clipboard#copy\" data-copy-to-clipboard-success-class=\"btn--success\" data-copy-to-clipboard-url-value=\""
    out += escape(v.get("at_path", ""))
    out += "\">\n"
    out += "          <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("link.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "</button>\n"
    out += "        <a class=\"btn message__action-btn center full-width message__edit-btn\" data-turbo-frame=\""
    out += escape(v.get("edit_dom", ""))
    out += "\" title=\"Edit\" aria-label=\"Edit\" href=\""
    out += escape(v.get("edit_path", ""))
    out += "\">\n"
    out += "          <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("pencil.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "</a>      </div>\n"
    out += "    </div>\n"
    out += "</details></div>\n"
    return out^

def avatar(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n"
    out += "  viewBox=\"0 0 512 512\" class=\"avatar\" aria-hidden=\"true\">\n"
    out += "  <defs>\n"
    out += "    <clipPath id=\"porthole\">\n"
    out += "      <circle cx=\"50%\" cy=\"50%\" r=\"50%\" />\n"
    out += "    </clipPath>\n"
    out += "  </defs>\n"
    out += "\n"
    out += "  <g>\n"
    out += "    <rect width=\"100%\" height=\"100%\" rx=\"50\" fill=\""
    out += escape(v.get("color", ""))
    out += "\" />\n"
    out += "\n"
    out += "    <text x=\"50%\" y=\"50%\" fill=\"#FFFFFF\"\n"
    out += "      text-anchor=\"middle\" dy=\"0.35em\"\n"
    out += "      "
    if (v.get("wide", "") == "1"):
        out += "textLength=\"85%\" lengthAdjust=\"spacingAndGlyphs\""
    out += "\n"
    out += "      font-family=\"-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif\"\n"
    out += "      font-size=\"230\"\n"
    out += "      font-weight=\"800\"\n"
    out += "      letter-spacing=\"-5\">\n"
    out += "      "
    out += escape(v.get("initials", ""))
    out += "\n"
    out += "    </text>\n"
    out += "  </g>\n"
    out += "</svg>\n"
    out += "\n"
    return out^

def bell(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<span>\n"
    out += "  <span class=\"button_to_change_notifying\"\n"
    out += "      data-controller=\"notifications\" data-notifications-subscriptions-url-value=\""
    out += escape(v.get("push_path", ""))
    out += "\" data-notifications-attention-class=\"btn--pulsing\">\n"
    out += "    <turbo-frame data-controller=\"turbo-frame\" data-action=\"notifications:ready@window-&gt;turbo-frame#load\" data-turbo-frame-url-param=\""
    out += escape(v.get("involvement_path", ""))
    out += "\" id=\""
    out += escape(v.get("involvement_dom", ""))
    out += "\">\n"
    out += "      <button class=\"btn\" data-action=\"click->notifications#attemptToSubscribe\" data-notifications-target=\"bell\">\n"
    out += "        <img aria-hidden=\"true\" src=\""
    out += asset("notification-bell-loading.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "        <img aria-hidden=\"true\" hidden=\"hidden\" src=\""
    out += asset("notification-bell-alert.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "        <span class=\"for-screen-reader\">Notification settings for this "
    out += escape(v.get("room_noun", ""))
    out += "</span>\n"
    out += "      </button>\n"
    out += "</turbo-frame>\n"
    out += "    <dialog data-notifications-target=\"notAllowedNotice\" class=\"dialog pad center center-block border-radius border shadow\" style=\"--inline-space: var(--block-space)\">\n"
    out += "      <div class=\"flex flex-column txt-align-center\">\n"
    out += "        <span class=\"btn btn--faux center txt-x-large\">\n"
    out += "          <img aria-hidden=\"true\" src=\""
    out += asset("notification-bell-alert.svg")
    out += "\" width=\"48\" height=\"48\" />\n"
    out += "          <span class=\"for-screen-reader\">Notifications alert</span>\n"
    out += "        </span>\n"
    out += "\n"
    out += "        <section>\n"
    out += "          <h1 class=\"txt-large margin-none\">Notifications aren’t allowed</h1>\n"
    out += "          <div class=\"txt-align-start margin-block-start\">\n"
    out += "            "
    out += v.get("browser_settings", "")
    out += "\n"
    out += "            "
    out += v.get("system_settings", "")
    out += "\n"
    out += "            "
    out += v.get("install_instructions", "")
    out += "\n"
    out += "          </div>\n"
    out += "        </section>\n"
    out += "\n"
    out += "        <form method=\"dialog\" class=\"flex align-center gap center\">\n"
    out += "          <button class=\"btn dialog__close\" autofocus=\"true\">\n"
    out += "            <span class=\"for-screen-reader\">Close</span>\n"
    out += "            <img aria-hidden=\"true\" src=\""
    out += asset("remove.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "          </button>\n"
    out += "        </form>\n"
    out += "      </div>\n"
    out += "    </dialog>\n"
    out += "  </span>\n"
    out += "</span>\n"
    return out^

def boost(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<div id=\""
    out += escape(v.get("dom_id", ""))
    out += "\"\n"
    out += "      class=\"boost boost-item flex-inline postion--relative max-width align-center fill-white gap\"\n"
    out += "      data-controller=\"boost-delete\" data-boost-delete-perform-class=\"boost--deleting\" data-boost-delete-reveal-class=\"expanded\" data-boost-delete-booster-id-value=\""
    out += escape(v.get("creator_id", ""))
    out += "\">\n"
    out += "    <figure class=\"avatar boost__avatar flex-item-no-shrink\">\n"
    out += "      <a title=\""
    out += escape(v.get("creator_title", ""))
    out += "\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\""
    out += escape(v.get("creator_path", ""))
    out += "\"><img aria-label=\""
    out += escape(v.get("creator_name", ""))
    out += " boosted "
    out += escape(v.get("content", ""))
    out += "\" src=\""
    out += escape(v.get("creator_avatar", ""))
    out += "\" width=\"48\" height=\"48\" /></a>\n"
    out += "    </figure>\n"
    out += "\n"
    out += "    <span role=\"button\" class=\""
    if (v.get("all_emoji", "") == "1"):
        out += "txt-small txt-medium"
    else:
        out += "txt-small"
    out += "\" data-action=\"click-&gt;boost-delete#reveal keydown.enter-&gt;boost-delete#reveal:prevent\" data-boost-delete-target=\"content\">"
    out += escape(v.get("content", ""))
    out += "</span>\n"
    out += "\n"
    out += "    <form class=\"button_to\" method=\"post\" action=\""
    out += escape(v.get("path", ""))
    out += "\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button data-action=\"boost-delete#perform\" data-boost-delete-target=\"button\" class=\"btn btn--negative flex-item-justify-end boost__delete\" type=\"submit\">\n"
    out += "      <img aria-hidden=\"true\" src=\""
    out += asset("minus.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "      <span class=\"for-screen-reader\">Delete this boost</span>\n"
    out += "</button></form>  </div>\n"
    out += "  <span id=\"delete_boost_accessible_label\" class=\"for-screen-reader\">Press enter to delete this boost</span>\n"
    return out^

def boosts(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<turbo-frame id=\""
