    out += escape(v.get("creator_name", ""))
    out += "</strong>\n"
    out += "              </span>\n"
    out += "              <a target=\"_top\" class=\"message__permalink\" href=\""
    out += escape(v.get("at_path", ""))
    out += "\"><time class=\"message__timestamp\" datetime=\""
