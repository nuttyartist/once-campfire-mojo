    out += "\">"
    out += escape(v.get("room_name", ""))
    out += "</a>\n"
    out += "              </span>\n"
    out += "            </h3>\n"
    out += "            "
    out += v.get("actions", "")
    out += "\n"
    out += "          </div>\n"
    out += "          \n"
    out += "<div id=\""
    out += escape(v.get("presentation_dom", ""))
    out += "\" dir=\"auto\" data-reply-target=\"body\" data-messages-target=\"body\">\n"
    out += "  "
    out += v.get("presentation", "")
    out += "\n"
