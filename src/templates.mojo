    out += "\" />\n"
    out += "    <span class=\"for-screen-reader\">Share file</span>\n"
    out += "  </button>\n"
    out += "</dialog>\n"
    return out^

def manifest(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "{\n"
    out += "  \"name\": "
    out += v.get("name", "")
    out += ",\n"
    out += "  \"icons\": [\n"
    out += "    {\n"
    out += "      \"src\": "
    out += v.get("logo_path_small", "")
    out += ",\n"
    out += "      \"type\": \"image/png\",\n"
    out += "      \"sizes\": \"192x192\"\n"
    out += "    },\n"
    out += "    {\n"
    out += "      \"src\": "
    out += v.get("logo_path", "")
    out += ",\n"
