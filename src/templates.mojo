    out += asset("arrow-left.svg")
    out += "\" />\n"
    out += "      <span class=\"for-screen-reader\">Exit search </span>\n"
    out += "</a>\n"
    out += "    <form class=\"margin-block flex-item-grow contain flex align-center gap\" data-controller=\"form\" data-action=\"keydown.esc-&gt;form#cancel\" action=\""
    out += escape(v.get("searches_path", ""))
    out += "\" accept-charset=\"UTF-8\" method=\"post\">\n"
    out += "      <div class=\"composer__input flex align-center flex-item-grow gap full-width input input--actor min-width\">\n"
    out += "        <img aria-hidden=\"true\" class=\"composer__input-hint colorize--black\" style=\"view-transition-name: input-btn;\" src=\""
    out += asset("search.svg")
