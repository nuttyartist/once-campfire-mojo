    out += escape(v.get("searches_path", ""))
    out += "\">\n"
    out += "          <img aria-hidden=\"true\" class=\"colorize--black\" src=\""
    out += asset("remove.svg")
    out += "\" width=\"14\" height=\"14\" />\n"
    out += "          <span class=\"for-screen-reader\">Clear search field</span>\n"
    out += "</a>\n"
    out += "        <button name=\"button\" type=\"submit\" class=\"btn btn--reversed flex-item-no-shrink txt-small\" style=\"--btn-border-radius: 0.5em\">\n"
    out += "          <img aria-hidden=\"true\" src=\""
    out += asset("arrow-up.svg")
    out += "\" />\n"
    out += "          <span class=\"for-screen-reader\">Search</span>\n"
    out += "</button>      </div>\n"
    out += "</form>  </div>\n"
    return out^

def search_nav(v: Dict[String, String]) raises -> String:
    var out = String()
    if (v.get("has_query", "") == "1"):
        out += "\n"
        out += "    <div class=\"searches__query flex align-center gap pad-block-start-half\">\n"
        out += "      <div class=\"btn btn--reversed btn--faux align-center gap txt-nowrap\">\n"
        out += "        <span class=\"overflow-ellipsis\">“"
        out += escape(v.get("query", ""))
        out += "”</span>\n"
        out += "        <span class=\"flex-item-no-shrink\">"
        out += escape(v.get("count", ""))
        out += "</span>\n"
        out += "</div>    </div>"
    out += "\n"
    out += "\n"
    out += "  <div class=\"searches__recents align-center gap pad-block-half overflow-y overflow-hide-scrollbar\">\n"
    out += "    "
    out += v.get("recents", "")
    out += "\n"
    out += "  </div>\n"
    return out^

def search_sidebar(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<div class=\"rooms position-relative flex flex-column gap overflow-y overflow-hide-scrollbar\">\n"
    out += "    "
    out += v.get("recents", "")
    out += "\n"
    out += "  </div>\n"
    return out^

def shared_room(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<a id=\""
    out += escape(v.get("dom_id", ""))
    out += "\" data-sorted-list-name=\""
    out += escape(v.get("name", ""))
    out += "\" style=\"--column-gap: 0.5em\" class=\""
    out += escape(v.get("classes", ""))
    out += "\" data-rooms-list-target=\"room\" data-badge-dot-target=\"unread\" data-sorted-list-target=\"item\" data-room-id=\""
    out += escape(v.get("room_id", ""))
    out += "\" href=\"/rooms/"
    out += escape(v.get("room_id", ""))
    out += "\">\n"
    out += "  <span class=\"overflow-ellipsis\">"
    out += escape(v.get("name", ""))
    out += "</span>\n"
    out += "</a>\n"
    return out^

def sidebar(v: Dict[String, String]) raises -> String:
    var out = String()
    out += v.get("frame_open", "")
    out += "\n"
    out += "  "
    out += v.get("rooms_stream_tag", "")
    out += "\n"
    out += "  "
    out += v.get("user_stream_tag", "")
    out += "\n"
    out += "\n"
    out += "  <div class=\"sidebar__container overflow-y overflow-hide-scrollbar\"\n"
    out += "      data-controller=\"badge-dot\"\n"
    out += "      data-badge-dot-unread-class=\"unread\"\n"
    out += "      data-action=\"rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize\">\n"
    out += "    <turbo-frame id=\"direct_rooms_control\" target=\"_top\">\n"
    out += "      <div class=\"directs gap overflow-x overflow-hide-scrollbar\">\n"
    out += "        <a class=\"direct direct__new\" data-turbo-frame=\"_self\" href=\"/rooms/directs/new\">\n"
    out += "          <span class=\"avatar avatar--icon\">\n"
    out += "            <img aria-hidden=\"true\" class=\"colorize--black\" src=\""
    out += asset("messages-add.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "          </span>\n"
    out += "\n"
    out += "          <span class=\"direct__author flex max-width min-width border-radius pad-inline-half\">\n"
    out += "            <span class=\"for-screen-reader\">New</span>\n"
    out += "            <span class=\"txt-small overflow-clip\">Ping</span>\n"
    out += "          </span>\n"
    out += "</a>\n"
    out += "        <div id=\"direct_rooms\" contents data-controller=\"sorted-list\" data-action=\"rooms-list:unread@window->sorted-list#updateItem\">\n"
    out += "          "
    out += v.get("directs", "")
    out += "        </div>\n"
    out += "\n"
    out += "        <div contents>\n"
    out += "          "
    out += v.get("placeholders", "")
    out += "        </div>\n"
    out += "      </div>\n"
    out += "    </turbo-frame>\n"
    out += "\n"
    out += "    <div class=\"rooms position-relative flex flex-column gap\">\n"
    out += "      <div id=\"shared_rooms\" contents data-controller=\"sorted-list\">\n"
    out += v.get("shared", "")
    out += "      </div>\n"
    out += "\n"
    if (v.get("can_create_rooms", "") == "1"):
        out += "        <a class=\"rooms__new-btn btn room align-center gap txt-reversed\" aria-label=\"New Chat Room\" href=\"/rooms/opens/new\">\n"
        out += "          <img aria-hidden=\"true\" style=\"view-transition-name: new-room\" src=\""
        out += asset("add.svg")
        out += "\" width=\"20\" height=\"20\" />\n"
        out += "</a>"
    out += "    </div>\n"
    out += "\n"
    out += "    <button class=\"btn sidebar__toggle\" data-action=\"toggle-class#toggle\">\n"
    out += "      <img aria-hidden=\"true\" src=\""
    out += asset("menu.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "      <span class=\"for-screen-reader\">Open menu</span>\n"
    out += "    </button>\n"
    out += "  </div>\n"
    out += "\n"
    out += "  <div class=\"flex align-end sidebar__tools gap justify-end\">\n"
    out += "    <a class=\"btn avatar flex-item-no-shrink sidebar__tool\" href=\"/users/me/profile\">\n"
    out += "      <img aria-hidden=\"true\" style=\"view-transition-name: avatar-"
    out += escape(v.get("creator_id", ""))
    out += "\" src=\""
    out += escape(v.get("creator_avatar", ""))
    out += "\" width=\"48\" height=\"48\" />\n"
    out += "      <span class=\"for-screen-reader\">My Settings</span>\n"
    out += "</a>\n"
    out += "    <a class=\"btn align-center gap txt-reversed sidebar__tool\" href=\"/account/edit\">\n"
    out += "      <img aria-hidden=\"true\" style=\"view-transition-name: account-settings\" src=\""
    out += asset("settings.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "      <span class=\"for-screen-reader\">Account Settings</span>\n"
    out += "</a>  </div>\n"
    out += "</turbo-frame>\n"
    return out^

def system_settings(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<details class=\"notifications-help hide-in-browser\" data-notifications-target=\"details\">\n"
    out += "  <summary class=\"btn\">\n"
    out += "    <img aria-hidden=\"true\" src=\""
    out += asset("external/gear.svg")
    out += "\" width=\"20\" height=\"20\" />\n"
    out += "    <strong>Check your "
    out += escape(v.get("operating_system", ""))
    out += " settings</strong>\n"
    out += "    <img aria-hidden=\"true\" class=\"disclosure\" src=\""
    out += asset("disclosure.svg")
    out += "\" width=\"10\" height=\"10\" />\n"
    out += "  </summary>\n"
    out += "\n"
    if (v.get("firefox", "") == "1")  and  (v.get("android", "") == "1"):
        out += "      <ol>\n"
        out += "        <li>Tap the <em><img alt=\"More options\" src=\""
        out += asset("menu-dots-vertical.svg")
        out += "\" width=\"16\" height=\"16\" /></em> menu button.</li>\n"
        out += "        <li>Tap <em>Settings</em>.</li>\n"
        out += "        <li>Tap <em>Notifications</em>.</li>\n"
        out += "        <li>Tap <em><img alt=\"the toggle button\" src=\""
        out += asset("external/switch.svg")
        out += "\" width=\"22\" height=\"22\" /></em> to <em>Allow "
        out += escape(v.get("browser", ""))
        out += " notifications</em>.</li>\n"
        out += "      </ol>\n"
    else:
        if (v.get("edge", "") == "1")  and  (v.get("desktop", "") == "1"):
            out += "      <ol>\n"
            out += "        <li>Click <em>Start</em>, then <em>Settings</em>.</li>\n"
            out += "        <li>Go to <em>System &gt; Notification</em>.</li>\n"
            out += "        <li>Click <em><img alt=\"the toggle button\" src=\""
            out += asset("external/switch.svg")
            out += "\" width=\"22\" height=\"22\" /></em> <em>ON</em> for Campfire.</li>\n"
            out += "      </ol>\n"
        else:
            if ((v.get("firefox", "") == "1")  or  (v.get("chrome", "") == "1"))  and  (v.get("desktop", "") == "1"):
                out += "      <ol>\n"
                if (v.get("windows", "") == "1"):
                    out += "          <li>Click <em>Start</em>, then <em>Settings</em>.</li>\n"
                    out += "          <li>Go to <em>System &gt; Notification</em>.</li>\n"
                    out += "          <li>Click <em><img alt=\"the toggle button\" src=\""
                    out += asset("external/switch.svg")
                    out += "\" width=\"22\" height=\"22\" /></em> <em>ON</em> for Campfire.</li>\n"
                else:
                    out += "          <li>Click <em aria-label=\"the Apple menu\"></em> in the top left.</li>\n"
                    out += "          <li>Click <em>System Settings…</em>.</li>\n"
                    out += "          <li>Click <em>Notifications</em>.</li>\n"
                    out += "          <li>Click <em>Campfire</em>.</li>\n"
                    out += "          <li>Click <em><img alt=\"the allow notifications switch\" src=\""
                    out += asset("external/switch.svg")
                    out += "\" width=\"22\" height=\"22\" /></em> to <em>Allow notifications</em>.</li>\n"
                out += "      </ol>\n"
            else:
                if (v.get("safari", "") == "1")  and  (v.get("desktop", "") == "1"):
                    out += "      <ol>\n"
                    out += "        <li>Click <em aria-label=\"the Apple menu\"></em> in the top left.</li>\n"
                    out += "        <li>Click <em>System Settings…</em>.</li>\n"
                    out += "        <li>Click <em>Notifications</em>.</li>\n"
                    out += "        <li>Click <em>Campfire</em>.</li>\n"
                    out += "        <li>Click <em><img alt=\"the allow notifications switch\" src=\""
                    out += asset("external/switch.svg")
                    out += "\" width=\"22\" height=\"22\" /></em> to <em>Allow notifications</em>.</li>\n"
                    out += "      </ol>\n"
                else:
                    if ((v.get("safari", "") == "1")  or  (v.get("chrome", "") == "1"))  and  (v.get("ios", "") == "1"):
                        out += "      <ol>\n"
                        out += "        <li>Open the <em><img aria-hidden=\"true\" src=\""
                        out += asset("external/gear.svg")
                        out += "\" width=\"20\" height=\"20\" /></em> Settings app.</li>\n"
                        out += "        <li>Scroll to and tap <em>Campfire</em>.</li>\n"
                        out += "        <li>Tap <em>Notifications</em>.</li>\n"
                        out += "        <li>Tap <em><img alt=\"the allow notifications switch button\" src=\""
                        out += asset("external/switch.svg")
                        out += "\" width=\"22\" height=\"22\" /></em> to <em>Allow Notifications</em>.</li>\n"
                        out += "      </ol>\n"
                    else:
                        if (v.get("chrome", "") == "1")  and  (v.get("android", "") == "1"):
                            out += "      <ol>\n"
                            out += "        <li>Open the <em><img aria-hidden=\"true\" src=\""
                            out += asset("external/gear.svg")
                            out += "\" width=\"20\" height=\"20\" /></em> Settings app.</li>\n"
                            out += "        <li>Tap <em>Notifications</em>.</li>\n"
                            out += "        <li>Tap <em>App notifications</em>.</li>\n"
                            out += "        <li>Scroll to <em>Campfire</em>.</li>\n"
                            out += "        <li>Tap <em><img alt=\"the switch\" src=\""
                            out += asset("external/switch.svg")
                            out += "\" width=\"22\" height=\"22\" /></em> to <em>Allow Notifications</em>.</li>\n"
                            out += "      </ol>\n"
                        else:
                            out += "      <p>Ensure notifications are allowed for "
                            out += escape(v.get("browser", ""))
                            out += " in your system settings.</p>\n"
    out += "</details>\n"
    return out^
