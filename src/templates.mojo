    return out^

def browser_settings(v: Dict[String, String]) raises -> String:
    var out = String()
    if not (((v.get("safari", "") == "1")  or  (v.get("chrome", "") == "1"))  and  (v.get("ios", "") == "1")):
        out += "  <details class=\"notifications-help\" data-notifications-target=\"details\">\n"
        out += "    <summary class=\"btn\">\n"
        out += "      <img aria-hidden=\"true\" src=\""
        out += asset("external/web.svg")
        out += "\" width=\"20\" height=\"20\" />\n"
        out += "      <strong>Check your "
        out += escape(v.get("browser", ""))
        out += " settings</strong>\n"
        out += "      <img aria-hidden=\"true\" class=\"disclosure\" src=\""
        out += asset("disclosure.svg")
        out += "\" width=\"10\" height=\"10\" />\n"
        out += "    </summary>\n"
        out += "\n"
        if (v.get("firefox", "") == "1")  and  (v.get("android", "") == "1"):
            out += "        <ol>\n"
            out += "          <li>Tap <em><img alt=\"the View site information button\" src=\""
            out += asset("lock.svg")
            out += "\" width=\"20\" height=\"20\" /></em> in the address bar.</li>\n"
            out += "          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>\n"
            out += "        </ol>\n"
        else:
            if (v.get("edge", "") == "1")  and  (v.get("desktop", "") == "1"):
                out += "        <h2 class=\"txt-normal txt-medium margin-block-start\">Turn on notifications for this website.</h2>\n"
                out += "        <ol>\n"
                out += "          <li>Click <em><img alt=\"the View site information button\" src=\""
                out += asset("lock.svg")
