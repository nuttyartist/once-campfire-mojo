def direct_new(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "\n"
    out += "\n"
    out += "\n"
    out += "\n"
    out += "<turbo-frame id=\"direct_rooms_control\" target=\"_top\">\n"
    out += "  <div class=\"directs directs--new flex flex-column gap\">\n"
    out += "    <form class=\"flex gap flex-item-grow\" data-controller=\"form\" data-action=\"keydown.esc-&gt;form#cancel\" action=\"/rooms/directs\" accept-charset=\"UTF-8\" method=\"post\">\n"
    out += "      <a class=\"btn flex-item-no-shrink\" data-turbo-frame=\"user_sidebar\" data-form-target=\"cancel\" href=\"/users/me/sidebar\">\n"
    out += "        <img aria-hidden=\"true\" src=\""
    out += asset("arrow-left.svg")
    out += "\" />\n"
    out += "        <span class=\"for-screen-reader\">Cancel changes</span>\n"
    out += "</a>\n"
    out += "      <section class=\"autocomplete__container unpad input input--actor\">\n"
    out += "        <div class=\"autocomplete__input input flex flex-wrap position-relative flex-item-grow\"\n"
    out += "            data-controller=\"autocomplete\" data-autocomplete-url-value=\"/autocompletable/users\">\n"
    out += "          <select name=\"user_ids[]\" data-autocomplete-target=\"select\" data-template-id=\"autocompletable-user\" multiple=\"true\" hidden required></select>\n"
    out += "\n"
    out += "          <template id=\"autocompletable-user\">\n"
    out += "  <div class=\"autocomplete__pill max-width\" data-value=\"\" tabindex=\"0\">\n"
    out += "    <img class=\"avatar flex-item-no-shrink\" data-content=\"avatar\" src=\"\" />\n"
    out += "    <span class=\"autocomplete-field__selected-value-text overflow-ellipsis flex-item-grow\" data-content=\"label\"></span>\n"
    out += "\n"
    out += "    <button type=\"button\" data-action=\"autocomplete#remove:prevent\" data-value=\"\" tabindex=\"-1\" class=\"btn btn--plain txt-small translucent flex-item-no-shrink\">\n"
    out += "      <img src=\""
    out += asset("remove-circle.svg")
    out += "\" aria-hidden=\"true\" class=\"colorize--black\">\n"
    out += "      <span class=\"for-screen-reader\">Remove <span data-content=\"screenReaderLabel\"></span></span>\n"
    out += "    </button>\n"
    out += "  </div>\n"
    out += "</template>\n"
    out += "\n"
    out += "\n"
    out += "\n"
    out += "          <input autocomplete=\"off\" autocorrect=\"off\" data-1p-ignore=\"true\" class=\"autocomplete__input input flex flex-wrap position-relative\" data-autocomplete-target=\"input\" data-action=\"input-&gt;autocomplete#search keydown-&gt;autocomplete#didPressKey\" type=\"text\" name=\"rooms_direct[user_ids_input]\" id=\"rooms_direct_user_ids_input\" />\n"
    out += "        </div>\n"
    out += "      </section>\n"
    out += "\n"
    out += "      <button name=\"button\" type=\"submit\" class=\"btn btn--reversed flex-item-no-shrink\">\n"
    out += "        <img aria-hidden=\"true\" src=\""
    out += asset("check.svg")
    out += "\" />\n"
    out += "        <span class=\"for-screen-reader\">Start Ping</span>\n"
    out += "</button></form>\n"
    out += "    <span class=\"txt-small translucent pad-inline-half center\">Type names to ping someone…</span>\n"
    out += "  </div>\n"
    out += "</turbo-frame>\n"
    out += "\n"
    return out^

def direct_placeholder(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<form class=\"button_to\" method=\"post\" action=\"/rooms/directs?user_ids%5B%5D="
    out += escape(v.get("id", ""))
    out += "\"><button class=\"direct borderless fill-transparent unpad\" type=\"submit\">\n"
    out += "  <span class=\"avatar\">\n"
    out += "    <img aria-hidden=\"true\" src=\""
    out += escape(v.get("avatar", ""))
    out += "\" />\n"
    out += "  </span>\n"
    out += "\n"
    out += "  <span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\">\n"
    out += "    <span class=\"txt-nowrap overflow-ellipsis\">\n"
    out += "      <span class=\"for-screen-reader\">Start a ping with</span>\n"
    out += "      "
    out += escape(v.get("first_name", ""))
    out += "\n"
    out += "    </span>\n"
    out += "  </span>\n"
    out += "</button></form>\n"
    return out^

def direct_room(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<a class=\""
    out += escape(v.get("classes", ""))
    out += "\" id=\""
    out += escape(v.get("dom_id", ""))
    out += "\" data-sorted-list-number=\""
    out += escape(v.get("epoch", ""))
    out += "\" data-rooms-list-target=\"room\" data-badge-dot-target=\"unread\" data-sorted-list-target=\"item\" data-room-id=\""
    out += escape(v.get("room_id", ""))
    out += "\" href=\"/rooms/"
    out += escape(v.get("room_id", ""))
    out += "\">\n"
    if (v.get("group", "") == "1"):
        out += "      <div class=\"avatar__group\">\n"
        out += v.get("avatars", "")
        out += "      </div>\n"
    else:
        out += "      <span class=\"avatar\">\n"
        out += "        <img aria-hidden=\"true\" src=\""
        out += escape(v.get("avatar", ""))
        out += "\" width=\"48\" height=\"48\" />\n"
        out += "      </span>\n"
    out += "\n"
    out += "    <span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\">\n"
    out += "      <span class=\"txt-nowrap overflow-ellipsis\">\n"
    out += "        <span class=\"for-screen-reader\">Ping with</span>\n"
    if (v.get("group", "") == "1"):
        out += "          "
        out += escape(v.get("initials", ""))
        out += "\n"
    else:
        out += "          "
        out += escape(v.get("first_name", ""))
        out += "\n"
    out += "      </span>\n"
    out += "    </span>\n"
    out += "</a>\n"
    return out^

def install_instructions(v: Dict[String, String]) raises -> String:
    var out = String()
    if not ((v.get("chrome", "") == "1")  or  ((v.get("firefox", "") == "1")  and  not (v.get("android", "") == "1"))):
        out += "  <details class=\"notifications-help pwa__instructions hide-in-pwa\" data-controller=\"pwa-install\" data-pwa-install-prompting-class=\"pwa--can-install\" data-notifications-target=\"details\">\n"
        out += "    <summary class=\"btn\">\n"
        out += "      <img aria-hidden=\"true\" src=\""
        out += asset("external/install.svg")
        out += "\" width=\"20\" height=\"20\" />\n"
        out += "      <strong>Install Campfire as a web app.</strong>\n"
        out += "      <img aria-hidden=\"true\" class=\"disclosure\" src=\""
        out += asset("disclosure.svg")
        out += "\" width=\"10\" height=\"10\" />\n"
        out += "    </summary>\n"
        out += "\n"
        if (v.get("edge", "") == "1"):
            out += "        <ol>\n"
            out += "          <li>Click <em><img alt=\"the app available - install Campfire chat button\" src=\""
            out += asset("install-edge.svg")
            out += "\" width=\"16\" height=\"16\" /></em>in the address bar.</li>\n"
            out += "          <li>Click <em>Install</em>.</li>\n"
            out += "        </ol>\n"
        else:
            if (v.get("chrome", "") == "1")  and  (v.get("android", "") == "1"):
                out += "        <ol>\n"
                out += "          <li>Tap the <em><img alt=\"More options\" src=\""
                out += asset("menu-dots-vertical.svg")
                out += "\" width=\"16\" height=\"16\" /></em> menu button.</li>\n"
                out += "          <li>Tap <em>Install app</em> in the menu.</li>\n"
                out += "        </ol>\n"
            else:
                if (v.get("firefox", "") == "1")  and  (v.get("android", "") == "1"):
                    out += "        <ol>\n"
                    out += "          <li>Tap the <em><img alt=\"More options\" src=\""
                    out += asset("menu-dots-vertical.svg")
                    out += "\" width=\"16\" height=\"16\" /></em> menu button.</li>\n"
                    out += "          <li>Tap <em>Install</em> in the menu.</li>\n"
                    out += "        </ol>\n"
                else:
                    if (v.get("safari", "") == "1")  and  (v.get("desktop", "") == "1"):
                        out += "        <ol>\n"
                        out += "          <li>Click <em>File</em> in the top left.</li>\n"
                        out += "          <li>Click <em>Add to Dock…</em>.</li>\n"
                        out += "        </ol>\n"
                    else:
                        if ((v.get("safari", "") == "1")  or  (v.get("chrome", "") == "1"))  and  (v.get("ios", "") == "1"):
                            out += "        <p>To receive push notifications in "
                            out += escape(v.get("browser", ""))
                            out += " for "
                            out += escape(v.get("operating_system", ""))
                            out += ", you must install Campfire as a web app.</p>\n"
                            out += "        <ol>\n"
                            out += "          <li>Tap <em><img alt=\"the share button\" src=\""
                            out += asset("external/share.svg")
                            out += "\" width=\"20\" height=\"20\" /></em></li>\n"
                            out += "          <li>Tap <em>Add to Home Screen</em>.</li>\n"
                            out += "        </ol>\n"
                        else:
                            out += "        <p>Some platforms require you to install Campfire as a web app to receive push notifications.</p>\n"
        out += "\n"
        out += "    <div class=\"margin-block-start txt-align-center pwa__installer\">\n"
        out += "      <hr class=\"separator margin-block\">\n"
        out += "      <button class=\"btn btn--reversed center\" data-action=\"pwa-install#promptInstall\">\n"
        out += "        <img aria-hidden=\"true\" src=\""
        out += asset("external/install.svg")
        out += "\" />\n"
        out += "        Install now\n"
        out += "      </button>\n"
        out += "    </div>\n"
        out += "  </details>\n"
    out += "\n"
    return out^

def layout(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<!DOCTYPE html>\n"
    out += "<html>\n"
    out += "  <head>\n"
    out += "    "
    out += v.get("title_tag", "")
    out += "\n"
    out += "\n"
    out += "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n"
    out += "    <meta name=\"view-transition\" content=\"same-origin\">\n"
    out += "    <meta name=\"color-scheme\" content=\"light dark\">\n"
    out += "    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n"
    out += "    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n"
    out += "    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n"
    out += "    "
    out += v.get("user_meta", "")
    out += "\n"
    out += "    "
    out += v.get("cable_meta", "")
    out += "\n"
    out += "\n"
    out += "    "
    out += v.get("vapid_meta", "")
    out += "\n"
    out += "    "
    out += v.get("prefetch_meta", "")
    out += "\n"
    out += "\n"
    out += "    "
    out += v.get("manifest_tag", "")
    out += "\n"
    out += "    "
    out += v.get("icon_tag", "")
    out += "\n"
    out += "    "
    out += v.get("apple_icon_tag", "")
    out += "\n"
    out += "\n"
    out += "    "
    out += v.get("stylesheets", "")
    out += "\n"
    out += "    "
    out += v.get("custom_styles", "")
    out += "\n"
    out += "\n"
    out += "    "
    out += v.get("importmap", "")
    out += "\n"
    out += "\n"
    out += v.get("head", "")
    out += "  </head>\n"
    out += "\n"
    out += "  <body class=\""
    out += escape(v.get("body_classes", ""))
    out += "\" data-controller=\"local-time lightbox\">\n"
    out += "    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n"
    out += "\n"
    out += "    <nav id=\"nav\">\n"
    out += v.get("nav", "")
    out += "    </nav>\n"
    out += "\n"
    out += "<main id=\"main-content\">\n"
    out += v.get("content", "")
    out += "\n"
    out += "      <footer id=\"footer\">\n"
    out += v.get("footer", "")
    out += "      </footer>\n"
    out += "    </main>\n"
    out += "\n"
    out += "    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n"
    out += v.get("sidebar", "")
    out += "    </aside>\n"
    out += "\n"
    out += "    "
    out += v.get("lightbox", "")
    out += "\n"
    out += "\n"
    out += "    <a href=\"https://once.com\" id=\"app-logo\" target=\"_blank\" aria-label=\"Once software from 37signals home page\">\n"
    out += "      <img alt=\"Campfire logo\" src=\""
    out += asset("campfire-icon.png")
    out += "\" width=\"256\" height=\"216\" />\n"
    out += "    </a>\n"
    out += "  </body>\n"
    out += "</html>\n"
    return out^

def lightbox(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<dialog class=\"lightbox\" aria-label=\"Image Viewer (Press escape to close)\" data-lightbox-target=\"dialog\" data-action=\"close->lightbox#reset\">\n"
    out += "  <img src=\"\" class=\"lightbox__image\" data-lightbox-target=\"zoomedImage\" />\n"
    out += "\n"
    out += "  <form method=\"dialog\" class=\"lightbox__btn\">\n"
