def message_template(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<script type=\"text/template\" data-messages-target=\"template\">\n"
    out += "  <div class=\"message message--me $messageClasses$\"\n"
    out += "      id=\"message_$clientMessageId$\"\n"
    out += "      data-format-message-target=\"message\"\n"
    out += "      data-user-id=\""
    out += escape(v.get("creator_id", ""))
    out += "\"\n"
    out += "      data-message-timestamp=\"$messageTimestamp$\"\n"
    out += "      data-messages-target=\"message\">\n"
    out += "    <div class=\"message__day-separator\"><time class=\"message__timestamp\" datetime=\"$messageDatetime$\" data-local-time-target=\"date\"></time></div>\n"
    out += "\n"
    out += "    <figure class=\"avatar message__avatar\">\n"
    out += "      <a title=\""
    out += escape(v.get("creator_title", ""))
    out += "\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\""
    out += escape(v.get("creator_path", ""))
    out += "\"><img aria-hidden=\"true\" src=\""
    out += escape(v.get("creator_avatar", ""))
    out += "\" width=\"48\" height=\"48\" /></a>\n"
    out += "    </figure>\n"
    out += "\n"
    out += "    <div class=\"message__body\">\n"
    out += "      <div class=\"message__body-content\">\n"
    out += "        <div class=\"message__meta\">\n"
    out += "          <h3 class=\"message__heading\">\n"
    out += "            <span class=\"message__author\"><strong>"
    out += escape(v.get("creator_name", ""))
    out += "</strong></span>\n"
    out += "            <span class=\"message__permalink\"><time class=\"message__timestamp\" datetime=\"$messageDatetime$\" data-local-time-target=\"time\"></time></span>\n"
    out += "          </h3>\n"
    out += "          <div class=\"message__actions\">\n"
    out += "            <div class=\"position-relative\">\n"
    out += "              <span class=\"btn message__action-btn message__options-btn\">\n"
    out += "                <img class=\"colorize--black\" aria-hidden=\"true\" src=\""
    out += asset("menu-dots-horizontal.svg")
    out += "\" />\n"
    out += "                <span class=\"for-screen-reader\">Message options</span>\n"
    out += "              </span>\n"
    out += "            </div class=\"position-relative\">\n"
    out += "          </div>\n"
    out += "        </div>\n"
    out += "        $body$\n"
    out += "      </div>\n"
    out += "    </div>\n"
    out += "  </div>\n"
    out += "</script>\n"
    return out^

