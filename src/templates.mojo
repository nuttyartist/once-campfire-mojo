def room_composer(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<div class=\"composer flex align-end gap position-relative\"\n"
    out += "      data-controller=\"typing-notifications\" data-typing-notifications-active-class=\"typing-indicator--active\">\n"
    out += "    <a class=\"btn flex-item-no-shrink margin-block-end composer__context-btn\" style=\"view-transition-name: input-switcher\" href=\""
