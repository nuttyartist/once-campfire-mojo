def search_footer(v: Dict[String, String]) raises -> String:
    var out = String()
    out += "<div class=\"composer flex align-end gap\">\n"
    out += "    <a class=\"btn flex-item-no-shrink margin-block-end\" style=\"view-transition-name: input-switcher; --btn-border-radius: 0.5em\" href=\""
