+//! Opt-in local comparison: transactional outbox, retained completion receipts.
+use crate::{Connection, Event, Result};
+use std::sync::LazyLock;
+pub fn enabled() -> bool {
+    static ENABLED: LazyLock<bool> = LazyLock::new(|| std::env::var("CAMPFIRE_DURABLE_JOBS").as_deref() == Ok("1"));
+    *ENABLED
+}
+pub fn prepare(conn: &Connection) -> Result<()> {
+    conn.execute_batch("CREATE TABLE IF NOT EXISTS campfire_jobs(id INTEGER PRIMARY KEY AUTOINCREMENT,kind TEXT NOT NULL,a INTEGER NOT NULL,b INTEGER NOT NULL,attempts INTEGER NOT NULL DEFAULT 0,available_at INTEGER NOT NULL DEFAULT 0,lease_until INTEGER NOT NULL DEFAULT 0,completed_at INTEGER,error TEXT NOT NULL DEFAULT ''); CREATE INDEX IF NOT EXISTS campfire_jobs_ready ON campfire_jobs(completed_at,available_at,lease_until,id); CREATE TABLE IF NOT EXISTS campfire_delivery_receipts(message_id INTEGER NOT NULL,target_id INTEGER NOT NULL,kind TEXT NOT NULL,PRIMARY KEY(message_id,target_id,kind)); UPDATE campfire_jobs SET lease_until=0 WHERE completed_at IS NULL;")?;
+    Ok(())
+}
+pub fn enqueue(conn: &Connection, event: &Event) -> Result<bool> {
+    let (kind, a, b) = match *event {
+        Event::PushMessage { room_id, message_id } => ("push", room_id, message_id),
+        Event::DeliverWebhook { bot_id, message_id } => ("webhook", bot_id, message_id),
+        Event::RemoveBannedContent { user_id } => ("remove", user_id, 0),
+        Event::PurgeBlob { blob_id } => ("purge", blob_id, 0),
+        Event::DisconnectUser { .. } => return Ok(false),
+    };
+    conn.prepare_cached("INSERT INTO campfire_jobs(kind,a,b) VALUES(?,?,?)")?.execute((kind, a, b))?;
+    Ok(true)
+}
