+// Durable workers poll the outbox; memory admission never stands between commit and recovery.
+async fn durable_work(app: App, registry: Arc<Registry>, stopping: watch::Receiver<bool>) {
+    while !*stopping.borrow() {
+        if std::env::var("CAMPFIRE_JOBS_PAUSED").as_deref() == Ok("1") {
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            continue;
+        }
+        let result = durable_one(app.clone(), &registry).await;
+        match result {
+            Ok(true) => (),
+            Ok(false) => tokio::time::sleep(Duration::from_millis(10)).await,
+            Err(error) => {
+                tracing::error!(%error, "durable worker failed; job retained");
+                tokio::time::sleep(Duration::from_millis(100)).await;
+            }
+        }
+    }
+}
+async fn durable_one(app: App, registry: &Registry) -> anyhow::Result<bool> {
+    let job = app.db.write(|tx| {
+        let mut stmt = tx.conn().prepare_cached("UPDATE campfire_jobs SET lease_until=unixepoch()+600,attempts=attempts+1 WHERE id=(SELECT id FROM campfire_jobs WHERE completed_at IS NULL AND attempts<10 AND available_at<=unixepoch() AND lease_until<unixepoch() ORDER BY id LIMIT 1) RETURNING id,kind,a,b")?;
+        let mut rows = stmt.query([])?;
+        Ok(match rows.next()? {
+            Some(row) => Some((row.get::<_,i64>(0)?,row.get::<_,String>(1)?,row.get::<_,i64>(2)?,row.get::<_,i64>(3)?)),
+            None => None,
+        })
+    }).await?;
+    let Some((id, kind, a, b)) = job else {
+        return Ok(false);
+    };
+    let event = match kind.as_str() {
+        "push" => Event::PushMessage { room_id: a, message_id: b },
+        "webhook" => Event::DeliverWebhook { bot_id: a, message_id: b },
+        "remove" => Event::RemoveBannedContent { user_id: a },
+        "purge" => Event::PurgeBlob { blob_id: a },
+        _ => return Err(anyhow!("unknown durable job kind {kind}")),
+    };
+    let handler = registry.get(JobKind::of(&event).unwrap()).ok_or_else(|| anyhow!("missing durable handler"))?;
+    let result = AssertUnwindSafe(handler(app.clone(), event)).catch_unwind().await;
+    let error = match result {
+        Ok(Ok(())) => None,
+        Ok(Err(error)) => Some(format!("{error:#}")),
+        Err(_) => Some("handler panicked".to_string()),
+    };
+    app.db
+        .write(move |tx| {
+            if let Some(error) = error {
+                tracing::error!(id,%error,"durable job failed; retry retained");
+                tx.conn().execute(
+                    "UPDATE campfire_jobs SET lease_until=0,available_at=unixepoch()+min(3600,attempts*attempts*5),error=? WHERE id=?",
+                    (error, id),
+                )?;
+            } else {
+                tx.conn().execute("UPDATE campfire_jobs SET completed_at=unixepoch(),lease_until=0,error='' WHERE id=?", [id])?;
+            }
+            Ok(())
+        })
+        .await?;
+    Ok(true)
+}
