diff --git a/src/jobs/durable.h b/src/jobs/durable.h
new file mode 100644
index 0000000..add8ca9
--- /dev/null
+++ b/src/jobs/durable.h
@@ -0,0 +1,39 @@
+/* Local durable comparison extension. SQL outbox admission is transactional. */
+#ifndef CF_DURABLE_H
+#define CF_DURABLE_H
+#include <sqlite3.h>
+#include <stdlib.h>
+#include <string.h>
+#include "cf.h"
+static inline bool cf_durable_enabled(void) {
+    const char *v=getenv("CAMPFIRE_DURABLE_JOBS"); return v && strcmp(v,"1")==0;
+}
+static inline int cf_durable_prepare(sqlite3 *db) {
+    return sqlite3_exec(db,"CREATE TABLE IF NOT EXISTS campfire_jobs(id INTEGER PRIMARY KEY AUTOINCREMENT,kind INTEGER NOT NULL,user_id INTEGER NOT NULL DEFAULT 0,room_id INTEGER NOT NULL DEFAULT 0,message_id INTEGER NOT NULL DEFAULT 0,blob_id INTEGER NOT NULL DEFAULT 0,task_type TEXT,variation TEXT,attempts INTEGER NOT NULL DEFAULT 0,available_at INTEGER NOT NULL DEFAULT 0,lease_until INTEGER NOT NULL DEFAULT 0,completed_at INTEGER,error TEXT NOT NULL DEFAULT ''); DROP INDEX IF EXISTS campfire_jobs_ready; CREATE INDEX IF NOT EXISTS campfire_jobs_pending ON campfire_jobs(kind,id) WHERE completed_at IS NULL; CREATE INDEX IF NOT EXISTS campfire_jobs_message ON campfire_jobs(kind,message_id) WHERE completed_at IS NULL; CREATE TABLE IF NOT EXISTS campfire_delivery_receipts(message_id INTEGER NOT NULL,target_id INTEGER NOT NULL,kind TEXT NOT NULL,PRIMARY KEY(message_id,target_id,kind));",NULL,NULL,NULL);
+}
+static inline int cf_durable_open(const char *path, sqlite3 **out) {
+    int rc=sqlite3_open_v2(path,out,SQLITE_OPEN_READWRITE|SQLITE_OPEN_CREATE|SQLITE_OPEN_NOMUTEX,NULL);
+    if(rc!=SQLITE_OK) return rc;
+    sqlite3_busy_timeout(*out,10000);
+    const char *mode=getenv("CAMPFIRE_SQLITE_SYNCHRONOUS");
+    return sqlite3_exec(*out,mode && strcmp(mode,"FULL")==0 ? "PRAGMA synchronous=FULL" : "PRAGMA synchronous=NORMAL",NULL,NULL,NULL);
+}
+static inline int cf_durable_event(sqlite3 *db,const cf_event *e) {
+    int kind;
+    switch(e->kind) {
+        case CF_EVENT_PUSH_MESSAGE: kind=0;break;
+        case CF_EVENT_DELIVER_WEBHOOK: kind=1;break;
+        case CF_EVENT_REMOVE_BANNED_CONTENT: kind=2;break;
+        case CF_EVENT_PURGE_BLOB: kind=3;break;
+        default:return SQLITE_OK;
+    }
+    sqlite3_stmt *s=NULL;
+    int rc=sqlite3_prepare_v2(db,"INSERT INTO campfire_jobs(kind,user_id,room_id,message_id,blob_id) VALUES(?,?,?,?,?)",-1,&s,NULL);
+    if(rc==SQLITE_OK) {
+        sqlite3_bind_int(s,1,kind); sqlite3_bind_int64(s,2,e->user_id);
+        sqlite3_bind_int64(s,3,e->room_id); sqlite3_bind_int64(s,4,e->message_id); sqlite3_bind_int64(s,5,e->blob_id);
+        rc=sqlite3_step(s)==SQLITE_DONE ? SQLITE_OK : sqlite3_errcode(db);
+    }
+    sqlite3_finalize(s);return rc;
+}
+#endif
