# Build natively for the selected Linux architecture (ARM64 or amd64).
FROM rust:1.98.1-trixie@sha256:a8a5f0a1e5fe7dfe1d352591e4a1c7dd2c08fd70475cae872cf3458ba0df0546
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o APT::Update::Error-Mode=any update -qq && apt-get install -y --no-install-recommends \
    clang libclang-rt-19-dev cmake perl autoconf automake libtool pkg-config zlib1g-dev \
    libvips-dev libxml2-dev libcurl4-openssl-dev libcrypt-dev libsqlite3-dev libmagic1t64 ffmpeg poppler-utils ruby ruby-dev ruby-minitest sqlite3 python3 \
    python3-venv curl unzip nodejs cloc && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy
RUN python3 -m venv /opt/mojo && /opt/mojo/bin/pip install mojo==1.1.0
ENV PATH="/opt/mojo/bin:${PATH}"
WORKDIR /workspace
