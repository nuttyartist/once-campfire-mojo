# Optional Compose settings. Copy to .env; never commit production secrets.
# Local use keeps the loopback-only defaults in compose.yaml.
PUBLIC_ORIGIN=http://localhost:8080
CAMPFIRE_SITE=http://:8080
VAPID_SUBJECT=mailto:admin@example.invalid
# For deploy/compose.production.yaml, set a real domain/contact and local image:
CAMPFIRE_DOMAIN=chat.example.com
CAMPFIRE_IMAGE=campfire-mojo:local
MOJO_WORKERS=4
JOB_CONCURRENCY=3
CAMPFIRE_RESPONSE_CACHE_MB=64
MULTIPART_BYTESIZE_LIMIT=10737418240
